# Copy to ~/.z2n.env, fill in, then: chmod 600 ~/.z2n.env
# ALL values must be inside double quotes (spaces and ; break the shell otherwise).
ZBX_URL="http://zabbix.example.com/zabbix/api_jsonrpc.php"
ZBX_TOKEN="your_zabbix_api_token"
NB_URL="http://netbox.example.com:8000"
# v2 token: "Bearer nbt_<key>.<token>"   v1 token: "Token <token>"
NB_AUTH="Bearer nbt_your_key.your_token"
NB_SITE="Main Site"
SKIP_IPS="127.0.0.1"
# keyword in the Zabbix host name -> NetBox site (sites must exist or are created)
SITE_MAP="Branch1=Site One;HQ=Site Two"
# optional
# PREFIXLEN="32"
# GROUP_FILTER="Network Devices,CCTV Devices"
# CAMERAS="0"            # disable Hikvision NVR camera import
# RULES_FILE="/path/to/rules.json"
